<?xml version="1.0" encoding="UTF-8"?>
<!-- TestFX MCP Server: JavaFX uygulamalarını AI agent'larıyla (Claude Code,
     opencode vb.) sürmek için stdio tabanlı MCP sunucusu.
     Derleme: mvn -q package  →  target/testfx-mcp.jar (fat-jar)
     Not: fat-jar, derlendiği platformun JavaFX native'lerini içerir
     (Linux'ta derlenen jar Linux'ta çalışır). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.testrunner</groupId>
  <artifactId>testfx-mcp</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>TestFX MCP Server</name>
  <description>JavaFX uygulamalarını TestFX üzerinden süren MCP (Model Context Protocol) sunucusu</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.11</javafx.version>
    <testfx.version>4.0.18</testfx.version>
    <mcp.version>1.1.3</mcp.version>
  </properties>

  <dependencies>
    <!-- Resmi Java MCP SDK (stdio JSON-RPC transport + şema) -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp.version}</version>
    </dependency>

    <!-- JavaFX: controls UI için, swing screenshot PNG dönüşümü için -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- TestFX: FxToolkit (uygulama başlatma) + FxRobot (etkileşim) -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>${testfx.version}</version>
    </dependency>

    <!-- TestFX API'si (NodeQuery) hamcrest tiplerine referans verir -->
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>2.2</version>
    </dependency>

    <!-- Monocle: xvfb olmadan headless çalıştırma (headless bayrağı) -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>openjfx-monocle</artifactId>
      <version>21.0.2</version>
    </dependency>

    <!-- MCP SDK slf4j kullanır; simple provider stderr'e yazar
         (stdout MCP transport'a aittir, kirletilmemeli) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>testfx-mcp</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!-- Tek çalıştırılabilir fat-jar: java -jar testfx-mcp.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>testfxmcp.Main</mainClass>
                </transformer>
                <!-- McpJsonMapper ServiceLoader ile bulunur; services birleştirilmeli -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
